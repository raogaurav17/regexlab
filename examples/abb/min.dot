  __start -> "M0";
  "M3" [shape=doublecircle];
  "M0" -> "M1" [label="a"];
  "M0" -> "M0" [label="b"];
  "M1" -> "M1" [label="a"];
  "M1" -> "M2" [label="b"];
  "M2" -> "M1" [label="a"];
  "M2" -> "M3" [label="b"];
  "M3" -> "M1" [label="a"];
  "M3" -> "M0" [label="b"];
}
